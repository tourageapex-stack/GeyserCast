# GEMINI_API_KEY: Optional. Enables the Gemini assistant and natural-language filters.
# Without it, forecasts still work from GeyserTimes.org data.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of this app when hosted.
APP_URL="MY_APP_URL"

# PORT: HTTP port for the combined Express + Vite server (default 3000).
# PORT=3000

